# ============================================================
# nextjs-supabase-starter — Environment variables
# Copy this file to `.env.local` and fill in your values.
# NEVER commit `.env.local`.
# ============================================================


# ────────────────────────────────────────────────────────────────
# 🟢 REQUIRED — app won't start correctly without these
# ────────────────────────────────────────────────────────────────

# Application identity (shown in header, page title, emails)
NEXT_PUBLIC_APP_NAME="My App"
APP_NAME="My App"
NEXT_PUBLIC_LOGO_PATH="/logo.png"

# Environment (dev | staging | prod) — shows "Test Mode" badge when "dev"
NEXT_PUBLIC_APP_ENV="dev"

# URLs and port
APP_PORT=3000
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase — backend (auth + DB + RLS)
# Local: `npx supabase start` will print these values.
# Prod: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace_with_supabase_publishable_key"

# Service-role key — server-only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key"


# ────────────────────────────────────────────────────────────────
# 🟡 OPTIONAL — app works without these; they unlock specific features.
# ────────────────────────────────────────────────────────────────

# --- Company branding (used in PDFs, email signatures, footer)
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Acme Inc."
NEXT_PUBLIC_COMPANY_DISPLAY_NAME="Acme"
NEXT_PUBLIC_COMPANY_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_COMPANY_CONTACT_PHONE="+1-555-0100"
NEXT_PUBLIC_COMPANY_WEBSITE="https://example.com"
NEXT_PUBLIC_COMPANY_ADDRESS_LINE1=""
NEXT_PUBLIC_COMPANY_CITY=""
NEXT_PUBLIC_COMPANY_PROVINCE=""
NEXT_PUBLIC_COMPANY_POSTAL_CODE=""
NEXT_PUBLIC_COMPANY_COUNTRY=""

# --- Brand styling
NEXT_PUBLIC_BRAND_PRIMARY="#2563eb"
NEXT_PUBLIC_BRAND_SECONDARY="#000000"
NEXT_PUBLIC_BRAND_FONT="Inter, Arial, sans-serif"

# --- Production URL (used in some email links)
NEXT_PUBLIC_PROD_APP_URL=""

# --- Restrict signup to allowed email domains
# Comma-separated. Users with emails outside these lists are rejected.
# Leave empty to allow any domain.
#   INTERNAL = your organization's employees (may receive ADMIN role)
#   PARTNER  = external authorized accounts (clients, contractors, etc.)
INTERNAL_EMAIL_DOMAINS=""
PARTNER_EMAIL_DOMAINS=""

# --- Microsoft / Azure SSO (enterprise single sign-on)
# Setup: portal.azure.com → App registrations → New registration
# Redirect URI must point to your Supabase Auth callback.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="http://localhost:54321/auth/v1/callback"

# --- Mailgun (transactional email: password reset, invitations, notifications)
# Without these, emails are not sent but auth still works
# (magic links are logged to the console in dev).
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL="My App <noreply@example.com>"

# --- Admin creation script (npm run create-admin)
# Leave ADMIN_PASSWORD empty to auto-generate a temporary password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Distributed rate limiting (multi-instance / serverless)
# Without these, falls back to in-memory store (fine for single-instance).
# Free tier: https://upstash.com → Redis → REST API
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

{
  "name": "nextjs-supabase-starter",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Yan Levasseur <levyan76@gmail.com>",
  "homepage": "https://github.com/levyan76/nextjs-supabase-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/levyan76/nextjs-supabase-starter.git"
  },
  "bugs": {
    "url": "https://github.com/levyan76/nextjs-supabase-starter/issues"
  },
  "keywords": [
    "nextjs",
    "supabase",
    "starter",
    "template",
    "boilerplate",
    "typescript",
    "tailwindcss",
    "shadcn-ui",
    "rls",
    "i18n",
    "vitest",
    "playwright"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"components/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"context/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"hooks/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"lib/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"messages/**/*.json\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"components/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"context/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"hooks/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"lib/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"messages/**/*.json\"",
    "generate:schema": "npx supabase gen types typescript --local > lib/supabase/types.ts",
    "supabase:reset": "npx supabase db reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.1.7",
    "@radix-ui/react-collapsible": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "json2csv": "^6.0.0-alpha.2",
    "konva": "^10.2.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "radash": "^12.1.1",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "description": "Production-grade Next.js 16 + Supabase starter with auth, RLS, i18n (FR/EN), rate limiting, feature flags, Vitest + Playwright, GitHub Actions CI, Docker. Bilingual README.",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
